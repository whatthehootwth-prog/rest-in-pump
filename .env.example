# Copy to your host's environment (the server reads process.env; it does not load this file itself).

# Required in production: the exact origins allowed to open a WebSocket.
ALLOWED_ORIGINS=https://your-domain.example

NODE_ENV=production
PORT=8787
# HOST defaults to 0.0.0.0 in production, 127.0.0.1 otherwise
# HOST=0.0.0.0

# Everyone shares one graveyard (MAX_ROOMS=1). ROOM_CAPACITY is how many players fit in it.
ROOM_CAPACITY=50
MAX_ROOMS=1

# How long a dropped player keeps their slot so a refresh / network blip resumes them (ms).
RECONNECT_GRACE_MS=20000

# Room snapshot rate (Hz).
SNAPSHOT_HZ=15

# Built client to serve (npm run build). Set to empty to disable static serving.
# STATIC_DIR=dist/client

# debug | info | warn | error
LOG_LEVEL=info

# Set to 1 only when running behind your own reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=0

# ---- graves + payments
# SQLite database file (keep it on a persistent disk and back it up).
DB_PATH=data/rip.sqlite
# NEAR mainnet RPC endpoints, tried in order.
NEAR_RPC_URLS=https://rpc.mainnet.fastnear.com,https://free.rpc.fastnear.com,https://rpc.mainnet.near.org
# Account that receives the NEAR for graves and offerings.
TREASURY_ACCOUNT=whatthehoot.near
# Prices in USD, paid in NEAR at the live NEAR/USD price.
GRAVE_PRICE_USD=0.01
OFFERING_MIN_USD=0.01
# Minutes a plot + meme stay reserved (and an offering stays open) while the player pays.
HOLD_MINUTES=15

# ---- Memorial NFTs (see README "Deploying the Memorial NFT contract")
# Set all three to switch minting on; leave all empty to keep memorials queued.
# NFT_CONTRACT=memorial.whatthehoot.near
# MINTER_ACCOUNT_ID=minter.whatthehoot.near
# MINTER_PRIVATE_KEY=ed25519:...   (a function-call key limited to mint_memorial; keep it secret)
# Public origin of the game; the contract's base_uri is <this>/nft.
# PUBLIC_BASE_URL=https://your-domain.example

# ---- Buyback rounds (see README "Buyback rounds"). Set both to switch on; TREASURY_ACCOUNT must then be the buyback account.
# BUYBACK_ACCOUNT_ID=buyback.whatthehoot.near
# BUYBACK_PRIVATE_KEY=ed25519:...
# BUYBACK_THRESHOLD_USD=20
# BUYBACK_TEAM_PERCENT=20
# BUYBACK_TEAM_WALLET=whatthehoot.near
# BUYBACK_MIN_HOLDING_WTH=100000
# NEAR kept in the buyback account for gas and storage (never spent on buybacks).
# BUYBACK_RESERVE_NEAR=0.5
# Extra accounts to leave out of the share-out, comma separated.
# BUYBACK_EXCLUDE=
